# ==========================================
# macOS Specific (맥 환경 필수 차단)
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.VolumeIcon.icns
.com.apple.timemachine.donotbackup
*.icloud

# ==========================================
# Development Tools (IDE / Editors)
# ==========================================
# VS Code 환경 설정 및 히스토리 차단
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# 데이터베이스 툴 (DBeaver 등) 임시 파일 및 커넥션 정보
# ※ 만약 DBeaver 설정이나 커넥션 세팅을 공유해야 한다면 이 부분을 제외하세요.
.dbeaver/
DBeaver/
*.bak

# ==========================================
# System & Backup Files
# ==========================================
# 시스템이 자동 생성하는 썸네일이나 백업 파일
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*~
*.bak
*.tmp
*.temp

# ==========================================
# Optional: Data & Logs (선택 사항)
# ==========================================
# 공부용이라 크기가 크거나 로컬 환경용 로그/테스트 데이터가 생길 경우 대비
*.log
*.sqlite
*.db